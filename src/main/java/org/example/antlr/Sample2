package com.delphi;

import java.util.Map;
import java.util.HashMap;
import java.util.ArrayList;
import java.util.Stack;
import java.util.Scanner;

public class ExecuteVisitor extends delphiBaseVisitor<Object> {
    static class Variable {
        String name;
        String type;
        Object value;
        public Variable(String name, String type) {
            this.name = name;
            this.type = type.toLowerCase();
            switch (type) {
                case "integer" -> this.value = 0;
                case "real" -> this.value = 0.0;
                case "string" -> this.value = "";
                case "boolean" -> this.value = false;
            }
        }
    }
    ArrayList<Variable> variables = new ArrayList<>();
    private Map<String, Object> memory = new HashMap<>();
    private Stack<Object> stack = new Stack<>();
    private Scanner scanner = new Scanner(System.in);

    @Override
    public Object visitProgram(delphiParser.ProgramContext ctx) {
        System.out.println("Program: " + ctx.programHeading().identifier().getText());
        return visitChildren(ctx);
    }

    @Override
    public Object visitBlock(delphiParser.BlockContext ctx) {
        return visitChildren(ctx);
    }

    @Override
    public Object visitStatement(delphiParser.StatementContext ctx) {
        //System.out.println("Statement: " + ctx.getText());
        if(ctx.getText().contains("writeln")){
            String text = ctx.getText();
            writeln(text);

        }
        if(ctx.getText().contains("readln")){
            try {
                readln(ctx.getText());
            } catch (NumberFormatException e) {
                System.out.println("invalid input  " +e.getMessage());
                System.exit(1);
            }
        }

        if(ctx.getText().contains(":=")){
            String[] parts = ctx.getText().split(":=");
            String var = parts[0].trim();
            String value = parts[1].trim();
            try {
                assignVal(var, value);
            } catch (NumberFormatException e) {
                System.out.println("invalid type assigned " + e.getMessage());
                System.exit(1);
            }
        }

        return visitChildren(ctx);
    }

    @Override
    public Object visitVariableDeclaration(delphiParser.VariableDeclarationContext ctx) {
        if(ctx.getText().contains(":")){
            String[] parts = ctx.getText().split(":");
            String var = parts[0].trim();
            String type = parts[1].trim();
            for(Variable variable : variables){
                if(variable.name.equals(var)) {
                    System.out.println("Variable " + var + " already declared");
                    return visitChildren(ctx);
                }
            }
            variables.add(new Variable(var, type));
        }
        return visitChildren(ctx);
    }

//    @Override
//    public Object visitWriteln(delphiParser.WritelnContext ctx) {
//        System.out.println("Writeln: " + ctx.getText());
//        return visitChildren(ctx);
//    }

    public void readln(String text) throws NumberFormatException{
        text = text.replace("readln", "");
        text = text.replace("(", "");
        text = text.replace(")", "");
        text = text.replace("'", "");
        if(!text.isEmpty()){
            for(Variable variable : variables){
                if(variable.name.equals(text)) {
                    String input = scanner.nextLine();
                    if(variable.type.equals("integer")){
                        variable.value = Integer.parseInt(input);
                        return;
                    } else if(variable.type.equals("real")){
                        variable.value = Double.parseDouble(input);
                        return;
                    } else if(variable.type.equals("string")){
                        variable.value = input;
                        return;
                    } else if(variable.type.equals("boolean")){
                        variable.value = Boolean.parseBoolean(input);
                        return;
                    }
                }
            }
            System.out.println("input variable not declared");
            System.exit(0);
        }else{
            System.out.println("input variable not specified");
            System.exit(0);
        }
    }
    public void assignVal(String var, String value) throws NumberFormatException {
        if(value.charAt(0)=='\'' && value.charAt(value.length()-1)=='\''
                || value.charAt(0)=='"' && value.charAt(value.length()-1)=='"'
                ||value.matches("^[0-9]+$")
                || value.matches("^[0-9]+.[0-9]+$")) {
            value = value.replace("'", "");
            value = value.replace("\"", "");
            for (Variable variable : variables) {
                if (variable.name.equals(var)) {
                    if (variable.type.equals("integer")) {
                        variable.value = Integer.parseInt(value);
                        return;
                    } else if (variable.type.equals("real")) {
                        variable.value = Double.parseDouble(value);
                        return;
                    } else if (variable.type.equals("string")) {
                        variable.value = value.substring(1, value.length() - 1);
                        return;
                    } else if (variable.type.equals("boolean")) {
                        variable.value = Boolean.parseBoolean(value);
                        return;
                    }
                }
            }
            System.out.println("Variable " + var + " not declared");
            System.exit(1);
        } else {
            for (Variable variable : variables) {
                if (variable.name.equals(value)) {
                    for (Variable variable1 : variables) {
                        if (variable1.name.equals(var)){
                            if (variable1.type.equals(variable.type)) {
                                variable1.value = variable.value;
                                return;
                            }else{
                                System.out.println("Type mismatch");
                                return;
                            }
                        }
                    }
                    System.out.println("Variable " + var + " not declared");
                    System.exit(1);
                }
            }
            System.out.println( value + " not declareda");
            System.exit(1);
        }
    }
    public void writeln(String text){
        text = text.replace("writeln", "");
        text = text.replace("(", "");
        text = text.replace(")", "");
        //text = text.replace("'", "");
        if(text.charAt(0)=='\'' && text.charAt(text.length()-1)=='\''
                || text.charAt(0)=='"' && text.charAt(text.length()-1)=='"'){
            text = text.substring(1, text.length()-1);
            System.out.println(text);
        } else if (text.matches("^[0-9]+$")
                || text.matches("^[0-9]+.[0-9]+$")) {
            System.out.println(text);
        } else {
            for(Variable variable : variables){
                if(variable.name.equals(text)) {
                    System.out.println(variable.value);
                    return;
                }
            }
            System.out.println("Variable " + text + " not declared");
            System.exit(1);
        }
    }
}