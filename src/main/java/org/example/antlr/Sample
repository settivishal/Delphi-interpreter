import org.antlr.v4.runtime.*;
import org.antlr.v4.runtime.tree.*;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.*;

// FieldInfo stores the type and visibility for a field.
class FieldInfo {
    String type;
    String visibility; // "private" or "public"

    FieldInfo(String type, String visibility) {
        this.type = type;
        this.visibility = visibility;
    }

    @Override
    public String toString() {
        return "FieldInfo{type='" + type + "', visibility='" + visibility + "'}";
    }
}

// Represents a class definition, including its fields, constructor, and destructor flags.
class ClassInfo {
    String name;
    // Map from field name to FieldInfo
    Map<String, FieldInfo> fields = new HashMap<>();
    boolean hasConstructor = false;
    boolean hasDestructor = false;

    ClassInfo(String name) {
        this.name = name;
    }

    @Override
    public String toString() {
        return "ClassInfo{name='" + name + "', fields=" + fields +
               ", hasConstructor=" + hasConstructor +
               ", hasDestructor=" + hasDestructor + "}";
    }
}

// Represents an instance of a class.
class ObjectInstance {
    ClassInfo classInfo;
    Map<String, Object> fieldValues = new HashMap<>();

    ObjectInstance(ClassInfo classInfo) {
        this.classInfo = classInfo;
        // Optionally initialize all fields to null.
        for (String fieldName : classInfo.fields.keySet()) {
            fieldValues.put(fieldName, null);
        }
    }

    @Override
    public String toString() {
        return "ObjectInstance of " + classInfo.name + " with fields=" + fieldValues;
    }
}

public class PascalInterpreter extends PascalBaseVisitor<Void> {

    // Maps for declared classes and created objects.
    private final Map<String, ClassInfo> classes = new HashMap<>();
    private final Map<String, ObjectInstance> objects = new HashMap<>();

    // Pointer to the class currently being processed.
    private ClassInfo currentClass = null;
    // Current visibility context ("public" or "private"). Default is public.
    private String currentVisibility = "public";

    @Override
    public Void visitProgram(PascalParser.ProgramContext ctx) {
        super.visitProgram(ctx);
        System.out.println("\n--- Program Summary ---");
        System.out.println("Declared classes:");
        for (String className : classes.keySet()) {
            System.out.println("  " + className + " -> " + classes.get(className));
        }
        System.out.println("Created objects:");
        for (String objName : objects.keySet()) {
            System.out.println("  " + objName + " -> " + objects.get(objName));
        }
        return null;
    }

    @Override
    public Void visitBlock(PascalParser.BlockContext ctx) {
        return super.visitBlock(ctx);
    }

    @Override
    public Void visitClassDeclaration(PascalParser.ClassDeclarationContext ctx) {
        String className = ctx.identifier().getText();
        System.out.println("Found class: " + className);
        currentClass = new ClassInfo(className);
        // Reset default visibility for a new class.
        currentVisibility = "public";
        visit(ctx.classBody());
        classes.put(className, currentClass);
        System.out.println("Class " + className + " details: " + currentClass);
        currentClass = null;
        return null;
    }

    @Override
    public Void visitClassBody(PascalParser.ClassBodyContext ctx) {
        return super.visitClassBody(ctx);
    }

    // When a visibility section is encountered, update the currentVisibility.
    @Override
    public Void visitVisibilitySection(PascalParser.VisibilitySectionContext ctx) {
        // The first child is the visibility keyword (PRIVATE or PUBLIC).
        currentVisibility = ctx.getChild(0).getText().toLowerCase();
        System.out.println("Entering " + currentVisibility + " section");
        // Continue visiting the members in this section.
        return super.visitVisibilitySection(ctx);
    }

    @Override
    public Void visitClassMemberDeclaration(PascalParser.ClassMemberDeclarationContext ctx) {
        if (ctx.variableDeclarationPart() != null) {
            visit(ctx.variableDeclarationPart());
        }
        if (ctx.constructorDeclaration() != null) {
            visit(ctx.constructorDeclaration());
        }
        if (ctx.destructorDeclaration() != null) {
            visit(ctx.destructorDeclaration());
        }
        // Ignoring other member types (procedures, functions) in this example.
        return null;
    }

    @Override
    public Void visitVariableDeclarationPart(PascalParser.VariableDeclarationPartContext ctx) {
        return super.visitVariableDeclarationPart(ctx);
    }

    // Capture each variable declaration along with the current visibility.
    @Override
    public Void visitVariableDeclaration(PascalParser.VariableDeclarationContext ctx) {
        if (currentClass != null) {
            String typeName = ctx.type_().getText();
            PascalParser.IdentifierListContext ids = ctx.identifierList();
            for (PascalParser.IdentifierContext idCtx : ids.identifier()) {
                String varName = idCtx.getText();
                FieldInfo field = new FieldInfo(typeName, currentVisibility);
                currentClass.fields.put(varName, field);
                System.out.println("Declared field '" + varName + "' of type '" + typeName +
                                   "' with visibility '" + currentVisibility + "' in class " + currentClass.name);
            }
        }
        return null;
    }

    @Override
    public Void visitConstructorDeclaration(PascalParser.ConstructorDeclarationContext ctx) {
        if (currentClass != null) {
            currentClass.hasConstructor = true;
            System.out.println("Constructor declared for class: " + currentClass.name);
        }
        return null;
    }

    @Override
    public Void visitDestructorDeclaration(PascalParser.DestructorDeclarationContext ctx) {
        if (currentClass != null) {
            currentClass.hasDestructor = true;
            System.out.println("Destructor declared for class: " + currentClass.name);
        }
        return null;
    }

    @Override
    public Void visitObjectInstantiation(PascalParser.ObjectInstantiationContext ctx) {
        String objectName = ctx.identifier(0).getText();
        String className = ctx.identifier(1).getText();
        ClassInfo ci = classes.get(className);
        if (ci == null) {
            System.out.println("Error: Unknown class " + className);
            return null;
        }
        if (ci.hasConstructor) {
            System.out.println("Calling constructor for class " + className + "...");
        } else {
            System.out.println("Warning: No constructor defined for class " + className);
        }
        ObjectInstance instance = new ObjectInstance(ci);
        objects.put(objectName, instance);
        System.out.println("Created object: " + objectName + " of class " + className);
        return null;
    }

    @Override
    public Void visitObjectDestruction(PascalParser.ObjectDestructionContext ctx) {
        String objName = ctx.identifier().getText();
        ObjectInstance instance = objects.get(objName);
        if (instance != null) {
            if (instance.classInfo.hasDestructor) {
                System.out.println("Calling destructor for object " + objName + " of class " + instance.classInfo.name + "...");
            }
            objects.remove(objName);
            System.out.println("Deleted object: " + objName);
        } else {
            System.out.println("Error: No such object " + objName + " to delete.");
        }
        return null;
    }

    public static void main(String[] args) throws IOException {
        if (args.length == 0) {
            System.err.println("Usage: java PascalInterpreter <file.pas>");
            System.exit(1);
        }
        String code = new String(Files.readAllBytes(Paths.get(args[0])));
        CharStream input = CharStreams.fromString(code);
        PascalLexer lexer = new PascalLexer(input);
        CommonTokenStream tokens = new CommonTokenStream(lexer);
        PascalParser parser = new PascalParser(tokens);
        ParseTree tree = parser.program();
        PascalInterpreter interpreter = new PascalInterpreter();
        interpreter.visit(tree);
    }
}